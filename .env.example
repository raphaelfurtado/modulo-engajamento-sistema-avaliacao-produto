# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Chave secreta do servidor (sb_secret_... ou a antiga service_role).
# NUNCA exponha no cliente: não use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres).
# Gere com: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

# Chave exigida no header x-admin-key para cadastrar produtos (POST /api/v1/products).
# Mínimo 16 caracteres.
ADMIN_API_KEY=
