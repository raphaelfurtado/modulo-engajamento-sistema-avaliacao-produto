# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Chave secreta do servidor (sb_secret_... ou a antiga service_role).
# NUNCA exponha no cliente: não use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres).
# Gere com: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

# Chave da OpenAI para o resumo de avaliações gerado por IA (Mastra + gpt-4o-mini).
# Opcional: sem ela, o site funciona normalmente e só não gera resumos.
OPENAI_API_KEY=

# Chave exigida no header x-api-key do POST /api/v1/products (cadastro de produtos
# pelo n8n ou pelo seed). Mínimo 32 caracteres. Sem ela, o cadastro fica fechado.
# Gere com: bun -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRODUCTS_API_KEY=
